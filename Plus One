import java.util.*;
public class Main
{
	public static void main(String[] args) {
		int[] arr={9};
	System.out.print(Arrays.toString(plusOne(arr)));
	}
	public static int[] plusOne(int[] arr){
	    	for(int i=arr.length-1;i>=0;i--){
		    if(arr[i]<9){
		        arr[i]++;
		        return arr;
		    }
		    arr[i]=0;
		}
		int[] res = new int[arr.length+1];
		res[0]=1;
		return res;
	}
}
