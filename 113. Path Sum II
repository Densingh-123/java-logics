/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<List<Integer>> res;
    public List<List<Integer>> pathSum(TreeNode root, int targetSum) {
        res = new ArrayList<>();
        List<Integer> currentPath = new ArrayList<>();
        dfs(root,targetSum,0,currentPath);
        return res;
    }
    public void dfs(TreeNode root, int targetSum,int currentSum,List<Integer> currentPath){
        if(root==null){
            return;
        }
        currentPath.add(root.val);
        currentSum+=root.val;
        if(root.left==null && root.right==null && currentSum==targetSum){
           res.add(new ArrayList<>(currentPath));
        }
        dfs(root.left,targetSum,currentSum,currentPath);
        dfs(root.right,targetSum,currentSum,currentPath);
        currentPath.remove(currentPath.size()-1);
    }
}
